{
  "name": "forge-marketing",
  "version": "1.0.0",
  "description": "FORGE marketing motion graphics (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.496",
    "@remotion/google-fonts": "4.0.496",
    "@remotion/media": "4.0.496",
    "@remotion/player": "4.0.496",
    "@remotion/tailwind-v4": "4.0.496",
    "@remotion/transitions": "4.0.496",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.496",
    "tailwindcss": "4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.496",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "studio": "remotion studio",
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render HelloForge out/hello-forge.mp4",
    "render:intro": "remotion render ForgeIntro out/forge-intro.mp4",
    "render:problem": "remotion render ProblemStory out/problem-story.mp4",
    "render:reel": "remotion render ForgeReel out/forge-reel.mp4 --image-format=png --video-bitrate=8M",
    "render:blackout": "remotion render Blackout out/blackout.mp4 --image-format=jpeg --jpeg-quality=92 --video-bitrate=8M --concurrency=2",
    "render:pitch": "remotion render ForgePitch out/pitch-investor.mp4 --props=stories/pitch-investor.json",
    "render:all": "pwsh -File scripts/render-all.ps1",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
